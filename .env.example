# Copy to .env and fill in. Placeholders only — never commit real values.

# ---- Rime (primary and default speech provider) ----
RIME_API_KEY=your_rime_api_key_here
# rime | sapi (offline Windows TTS, for checking the loop) | silent | auto
TTS_PROVIDER=auto
# Overrides for config.py defaults. Leave blank to use the pinned values.
RIME_MODEL_ID=coda
RIME_SPEAKER_EN=
RIME_SPEAKER_HI=

# ---- LiveKit (realtime transport) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ---- LLM roles (decided at the end; "stub" runs the whole agent offline) ----
# provider: stub | anthropic | openai | groq
LLM_FAST_PROVIDER=stub
LLM_FAST_MODEL=
LLM_STRONG_PROVIDER=stub
LLM_STRONG_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ---- Speech recognition (stt/settings.py has every knob) ----
# auto = Whisper large-v3-turbo on Groq when GROQ_API_KEY is set, else local faster-whisper
# groq | local
STT_PROVIDER=auto
WHISPER_MODEL_SIZE=base   # the local model (also the fallback for groq)

# ---- Web search for out-of-syllabus questions ----
# provider: stub | duckduckgo
WEB_SEARCH_PROVIDER=stub

# ---- Stress test knob (PS full-duplex test): fixed delay injected into the
#      web search tool call, in milliseconds. 0 = off.
STRESS_DELAY_MS=0

# ---- Retrieval ----
RETRIEVAL_TAU=0.35
EMBEDDER=hash            # hash (offline, tests) | fastembed (multilingual dense)
